# ==============================================================================
# .gitignore for Banking Management System (C Project)
# ==============================================================================

# Compiled Executables
*.exe
*.out
*.app
banking
banking.exe

# Compiled Object Files & Libraries
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll

# Debug Symbols & Build Artifacts
*.pdb
*.ilk
*.idb
*.dSYM/
*.gch

# Runtime Data Files (Auto-generated by program)
# Uncomment the line below if you prefer NOT to track runtime database files in git
*.dat

# Temporary & Log Files
*.log
*.tmp
errors.txt
gcc_err.txt
gcc_out.txt

# Editor & IDE Configs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
